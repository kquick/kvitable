dev
 subcmd
   build
     Builds the kvitable library
       exec = cabal build kvitable
   test
     testcase
       test-kvitable
         type = EXE
         runner = cabal_test
     testrunner
       cabal_test
         exec = cabal test {TestName}

   flake_update =
      Update flake dependencies =
        in dir = {TopDir}
        exec = nix flake update --option tarball-ttl 60

   update_nix_derivs =
     Update local static nix derivations
       in dir = {TopDir}/nix
       exec = |
          set -e
          nix run nixpkgs#cabal2nix .. > kvitable.nix
          nix run nixpkgs#cabal2nix https://github.com/bgamari/html-parse -- --revision=$(nix flake metadata --json | nix run nixpkgs#jq '.locks.nodes."html-parse-src".locked.rev' | sed -e 's,",,g') > html-parse.nix
          nix run nixpkgs#cabal2nix https://github.com/monadfix/microlens -- --subpath=microlens --revision=$(nix flake metadata --json | nix run nixpkgs#jq '.locks.nodes."microlens-src".locked.rev' | sed -e 's,",,g') > microlens.nix
          nix run nixpkgs#cabal2nix https://github.com/GaloisInc/parameterized-utils -- --revision=$(nix flake metadata --json | nix run nixpkgs#jq '.locks.nodes."parameterized-utils-src".locked.rev' | sed -e 's,",,g') > parameterized-utils.nix

   nixbuild:old
     Uses nix to build with old GHC versions
       in dir = {TopDir}
       exec =
         nix build --no-link --override-input nixpkgs github:nixos/nixpkgs/25.05 $(
           for X in 810 90 92 ; do
             echo ".#kvitable.ghc$X"
           done)
         nix build --no-link $(for X in 94 ; do echo ".#kvitable.ghc$X"; done)
   nixbuild:recent
     Uses nix to build with recent GHC versions
       in dir = {TopDir}
       exec = nix build --no-link $(for X in 96 98 ; do echo ".#kvitable.ghc$X"; done)
   nixbuild
     Uses nix to build with current GHC versions
       in dir = {TopDir}
       exec = nix build --no-link $(for X in 910 912 914 ; do echo ".#kvitable.ghc$X"; done)
   nixbuild:all =
     Uses nix to build with all supported GHC versions =
       in dir = {TopDir}
       needs = nixbuild nixbuild:old nixbuild:recent
       exec = echo All nix builds completed
